/data

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Large, regenerable derived caches (rebuilt by the notebooks from data/).
# Small results (CSV/TXT summaries, PNG figures) ARE tracked.
results/*.parquet
results/**/cache/

# Run-time logs (chain manifests live in results/, but per-step logs and the
# top-level run capture are ephemeral)
logs/
run.log
